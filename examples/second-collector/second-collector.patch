+/**
+ * The second street buyer: the house digger across Main Street pays 2× for HOUSE
+ * records and turns everything else down (mock mode).
+ */
+import { expect, test, type Page } from "@playwright/test";
+import { goTo, pageErrors, shot, startGame, teleport, until } from "./helpers";
+
+/** Pick up `id` in the shop, pay for it and close the receipt. */
+async function buy(page: Page, id: string): Promise<void> {
+  const dialog = page.locator("dialog.dlg[open]");
+  await teleport(page, { x: 0, z: -2, heading: Math.PI });
+  await goTo(page, `record:${id}`);
+  await page.keyboard.press("KeyE");
+  await page.keyboard.press("Enter"); // Pick up
+  await until(page, (x) => x.hand?.shopRecordId === id, `picked up ${id}`);
+  await goTo(page, "cashier");
+  await page.keyboard.press("KeyE");
+  await page.keyboard.press("Enter"); // Pay
+  await expect(dialog.locator("[data-receipt-link]").first()).toBeVisible({ timeout: 20_000 });
+  await page.keyboard.press("Escape");
+  await expect(dialog).toHaveCount(0);
+}
+
+test("house digger: refuses non-HOUSE, pays 2× for HOUSE", async ({ page }) => {
+  await startGame(page, "?chain=mock&latency=300");
+  const dialog = page.locator("dialog.dlg[open]");
+
+  // A HIP HOP record: politely refused.
+  await buy(page, "low-tide-tapes"); // 12.00 FUSD
+  await goTo(page, "buyer:house");
+  await expect(page.locator(".prompt-label")).toHaveText("Sell to the house digger");
+  await page.keyboard.press("KeyE");
+  await expect(page.locator(".toast", { hasText: "I only dig HOUSE" })).toBeVisible();
+  await expect(dialog).toHaveCount(0);
+  await page.waitForTimeout(600);
+  await shot(page, "rehearsal-s3-1-refusal");
+
+  // Sell that one to the collector (1.5×) so the hands are free.
+  await goTo(page, "buyer:collector");
+  await page.keyboard.press("KeyE");
+  await expect(dialog.locator(".dlg-title")).toHaveText("Sell Low Tide Tapes for 18.00 FUSD?");
+  await page.keyboard.press("Enter");
+  await until(page, (x) => x.sold.length === 1 && x.op === null, "sold to the collector");
+
+  // A HOUSE record: 25.00 → 50.00 FUSD.
+  await buy(page, "warehouse-gospel");
+  // Stand off to one side so the camera sees the digger past the player.
+  await teleport(page, { x: 0.3, z: 15.6, heading: 0 });
+  await page.waitForFunction(() => (window as any).__game.controller.near?.id === "buyer:house");
+  await expect(page.locator(".big-toast")).toBeHidden({ timeout: 15_000 });
+  await page.waitForTimeout(1500);
+  await shot(page, "rehearsal-s3-2-house-digger");
+  await page.keyboard.press("KeyE");
+  await expect(dialog.locator(".dlg-title")).toHaveText("Sell Warehouse Gospel for 50.00 FUSD?");
+  await expect(dialog.locator(".dlg-eyebrow")).toContainText("THE HOUSE DIGGER");
+  await expect(dialog).toContainText("2× shop price");
+  await shot(page, "rehearsal-s3-3-offer");
+  await page.keyboard.press("Enter"); // Sell
+  await expect(page.locator(".big-toast")).toContainText("SOLD", { timeout: 20_000 });
+  const s = await until(page, (x) => x.sold.length === 2 && x.op === null, "sold to the house digger");
+  expect(s.sold[1]?.paid).toBe("50000000");
+  // 100 - 12 + 18 - 25 + 50
+  expect(s.balance).toBe("131000000");
+  // Only one buyer can be away: the collector was called back for this sale.
+  expect(await page.evaluate(() => (window as any).__game.state().buyerAway?.npcId)).toBe("buyer:house");
+  await page.waitForTimeout(800);
+  await shot(page, "rehearsal-s3-4-sold");
+
+  expect(pageErrors(page)).toEqual([]);
+});
