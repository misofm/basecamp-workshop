# Copy to .env (gitignored); Bun loads it automatically for every script.
# ElevenLabs API key, only for catalog/scripts/generate-audio.ts.
ELEVENLABS_API_KEY=
# Sui signer (suiprivkey1...) for the miso CLI and the publishing scripts; never commit it.
SUI_PRIVATE_KEY=
# Command that starts the miso CLI, e.g. bun /path/to/cli/src/index.ts (default: miso on PATH).
MISO_CLI=
