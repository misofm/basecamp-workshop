@@ -0,0 +1,20 @@
+import { expect, test } from "@playwright/test";
+import { BUYERS, COLLECTOR, HOUSE_DIGGER, buyerFor, buyerProfile, buysSection } from "../../src/game/npc-buyers";
+
+test("the house digger pays 2x, the collector 1.5x", () => {
+  expect(buyerFor(HOUSE_DIGGER, 12_000_000n).offer).toBe(24_000_000n);
+  expect(buyerFor(COLLECTOR, 12_000_000n).offer).toBe(18_000_000n);
+});
+
+test("the house digger only buys HOUSE; the collector buys anything", () => {
+  expect(buysSection(HOUSE_DIGGER, "HOUSE")).toBe(true);
+  expect(buysSection(HOUSE_DIGGER, "JAZZ")).toBe(false);
+  expect(buysSection(COLLECTOR, "JAZZ")).toBe(true);
+});
+
+test("buyer ids map to profiles with distinct valid addresses", () => {
+  expect(buyerProfile("buyer:house")).toBe(HOUSE_DIGGER);
+  expect(buyerProfile("buyer:collector")).toBe(COLLECTOR);
+  for (const b of BUYERS) expect(b.address).toMatch(/^0x[0-9a-f]{64}$/);
+  expect(new Set(BUYERS.map((b) => b.address)).size).toBe(BUYERS.length);
+});
