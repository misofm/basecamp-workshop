{
  "name": "miso-basecamp-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "typecheck": "tsc --noEmit",
    "stage": "VITE_MISO_CHAIN=testnet vite build && vite preview --host 0.0.0.0",
    "deploy": "node scripts/check-deploy.mjs && npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@misofm/platform": "0.45.0",
    "@mysten/bcs": "2.1.2",
    "@mysten/move-bytecode-template": "0.4.1",
    "@mysten/sui": "2.29.0",
    "@unconfirmed/sui-effect": "0.2.2",
    "effect": "4.0.0-rc.112",
    "hls.js": "^1.7.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
