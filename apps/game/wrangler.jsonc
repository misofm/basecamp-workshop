{
  // Pure static-assets deploy of dist/ (no Worker code, no server): `npm run deploy`.
  //
  // !!! KEYS ARE BAKED INTO THE JS. `vite build` compiles VITE_PLAYER_SUI_PRIVATE_KEY and
  // VITE_GAME_SUI_PRIVATE_KEY from .env.local into the testnet chunk in dist/, so anyone
  // who can load the site can read both testnet keys. Only deploy a keyed build behind
  // Cloudflare Access (or equivalent access control); never deploy one publicly. A build
  // made without .env.local has no keys: mock mode works, ?chain=testnet shows the live
  // catalog and "Testnet keys missing".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "basecamp-workshop-game",
  "compatibility_date": "2026-10-01",
  // Keyed builds sit behind Cloudflare Access on the workers.dev hostname; per-version
  // preview URLs are separate hostnames, so keep them off.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
