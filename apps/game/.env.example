# Copy to apps/game/.env.local (gitignored) and fill in. SUI TESTNET KEYS ONLY.
#
# !!! WARNING: every VITE_* value is compiled INTO THE BUILT JAVASCRIPT. Anyone who can
# load a build made with these set can read both keys. Never use a key that holds real
# funds, and only host a keyed build behind access control (Cloudflare Access).
#
# Create keys from the repo root (writes keys/<name>.key, prints the address):
#   bun scripts/new-key.ts player
#   bun scripts/new-key.ts game
# then paste each file's suiprivkey1... line below and fund both addresses with
# testnet SUI at https://faucet.sui.io (FakeUSD comes from the in-game ATM).

# The single player wallet: buys Records, uses the ATM, sells to the collector.
VITE_PLAYER_SUI_PRIVATE_KEY=
# The game world = the collector NPC: receives sold Records, pays for them in FakeUSD.
VITE_GAME_SUI_PRIVATE_KEY=
